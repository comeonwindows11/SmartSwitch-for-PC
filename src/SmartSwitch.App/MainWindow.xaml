<Window x:Class="SmartSwitch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartSwitch Migration Tool"
        Width="1220"
        Height="790"
        MinWidth="1020"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#142A49">
            <Grid Margin="18,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="42"
                            Height="42"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="12">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="20"
                                   Foreground="White"
                                   Text="&#xE8AB;" />
                    </Border>
                    <StackPanel Margin="12,1,0,0">
                        <TextBlock FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="SmartSwitch" />
                        <TextBlock FontSize="11"
                                   Foreground="#9DB3D1"
                                   Text="MIGRATION TOOL" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Command="{Binding NavigateHomeCommand}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="28"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Text="&#xE80F;" />
                            <TextBlock Text="Démarrage" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,6,0,0"
                            Command="{Binding NavigateDonorCommand}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="28"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Text="&#xE898;" />
                            <TextBlock Text="PC donneur" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,6,0,0"
                            Command="{Binding NavigateReceiverCommand}"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="28"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Text="&#xE896;" />
                            <TextBlock Text="PC receveur" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="4"
                        Padding="14"
                        Background="#1B3559"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Foreground="#9DB3D1"
                                   FontSize="11"
                                   Text="CE POSTE" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Text="{Binding ComputerName}" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="#9DB3D1"
                                   FontSize="11"
                                   Text="{Binding AppVersion}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding Breadcrumb}" />
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource AccentBrush}" />
                        <TextBlock Margin="8,0,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Application prête" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Margin="30,26"
                            Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
