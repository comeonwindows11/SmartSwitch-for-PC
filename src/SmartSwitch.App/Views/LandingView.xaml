<UserControl x:Class="SmartSwitch.App.Views.LandingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,18">
            <Grid>
                <StackPanel>
                    <TextBlock FontSize="30"
                               FontWeight="Bold"
                               Text="Migrer ce PC, simplement." />
                    <TextBlock Margin="0,8,0,0"
                               MaxWidth="720"
                               HorizontalAlignment="Left"
                               FontSize="15"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Choisissez le rôle de ce poste. Les deux PC doivent exécuter SmartSwitch et être sur un réseau joignable."
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Padding="12,7"
                        Background="#E9F8F4"
                        CornerRadius="18">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,7,0"
                                 Fill="{StaticResource AccentBrush}" />
                        <TextBlock Foreground="#12755F"
                                   FontWeight="SemiBold"
                                   Text="Prêt à migrer" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="56"
                                Height="56"
                                HorizontalAlignment="Left"
                                Background="#EAF1FD"
                                CornerRadius="16">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="25"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Text="&#xE898;" />
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,20,0,0">
                            <TextBlock FontSize="20"
                                       FontWeight="Bold"
                                       Text="Transférer depuis ce PC" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Ce poste devient le PC donneur."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,18,0,24">
                            <TextBlock Margin="0,4"
                                       Text="✓ Choisir les dossiers du profil" />
                            <TextBlock Margin="0,4"
                                       Text="✓ Entrer l'adresse et le code du receveur" />
                            <TextBlock Margin="0,4"
                                       Text="✓ Vérifier avant l'envoi" />
                        </StackPanel>
                        <Button Grid.Row="3"
                                Command="{Binding ShowDonorCommand}"
                                Content="Configurer le PC donneur  →"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="56"
                                Height="56"
                                HorizontalAlignment="Left"
                                Background="#E8F8F4"
                                CornerRadius="16">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="25"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="&#xE896;" />
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,20,0,0">
                            <TextBlock FontSize="20"
                                       FontWeight="Bold"
                                       Text="Recevoir sur ce PC" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Ce poste devient le PC receveur."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,18,0,24">
                            <TextBlock Margin="0,4"
                                       Text="✓ Générer un code d'association" />
                            <TextBlock Margin="0,4"
                                       Text="✓ Choisir le dossier de destination" />
                            <TextBlock Margin="0,4"
                                       Text="✓ Contrôler l'intégrité à la réception" />
                        </StackPanel>
                        <Button Grid.Row="3"
                                Command="{Binding ShowReceiverCommand}"
                                Content="Configurer le PC receveur  →"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="20"
                        Background="#EAF1FD"
                        BorderBrush="#CBDAF2"
                        BorderThickness="1"
                        CornerRadius="13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,1,15,0"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="22"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Text="&#xE72E;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Association protégée" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Le code à 8 chiffres authentifie une session TLS temporaire. Chaque fichier est ensuite contrôlé par SHA-256."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2"
                        Padding="20"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="13">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="Poste actuel" />
                        <TextBlock Margin="0,7,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding ComputerName}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource MutedTextBrush}">
                            <Run Text="{Binding UserName, Mode=OneWay}" />
                            <Run Text=" • " />
                            <Run Text="{Binding WindowsVersion, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                <Border Padding="10,5" Background="#EEF2F7" CornerRadius="6">
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="SAFE · lecture seule" />
                </Border>
                <Border Margin="8,0,0,0"
                        Padding="10,5"
                        Background="#EAF1FD"
                        CornerRadius="6">
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}"
                               Text="ADVANCED · transfert standard" />
                </Border>
                <Border Margin="8,0,0,0"
                        Padding="10,5"
                        Background="#F2ECFD"
                        CornerRadius="6">
                    <TextBlock FontSize="12"
                               Foreground="#6D4BB5"
                               Text="CUSTOM · sélection experte" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
