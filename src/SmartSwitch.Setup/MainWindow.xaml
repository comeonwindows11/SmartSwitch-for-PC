<Window x:Class="SmartSwitch.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="820"
        Height="540"
        MinWidth="760"
        MinHeight="500"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="#142A49">
      <Grid Margin="24,28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="48" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="46"
                  Height="46"
                  Background="{StaticResource PrimaryBrush}"
                  CornerRadius="13">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="22"
                       Foreground="White"
                       Text="&#xE8AB;" />
          </Border>
          <StackPanel Margin="11,3,0,0">
            <TextBlock FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Text="SmartSwitch" />
            <TextBlock FontSize="11"
                       Foreground="#9DB3D1"
                       Text="SETUP WIZARD" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2">
          <TextBlock FontSize="12"
                     Foreground="#8EA7C8"
                     Text="ÉTAPES" />
          <TextBlock Margin="0,17,0,0"
                     FontWeight="SemiBold"
                     Foreground="White"
                     Text="1   Bienvenue" />
          <TextBlock Margin="0,15,0,0"
                     Foreground="#B4C5DC"
                     Text="2   Options" />
          <TextBlock Margin="0,15,0,0"
                     Foreground="#B4C5DC"
                     Text="3   Installation" />
          <TextBlock Margin="0,15,0,0"
                     Foreground="#B4C5DC"
                     Text="4   Terminé" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   FontSize="11"
                   Foreground="#8EA7C8"
                   Text="Version 0.1.0 • Installation par utilisateur"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="76" />
      </Grid.RowDefinitions>

      <Grid Margin="42,38,42,24">
        <Grid Visibility="{Binding IsWelcome, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel VerticalAlignment="Center">
            <Border Width="68"
                    Height="68"
                    HorizontalAlignment="Left"
                    Background="#EAF1FD"
                    CornerRadius="20">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="30"
                         Foreground="{StaticResource PrimaryBrush}"
                         Text="&#xE896;" />
            </Border>
            <TextBlock Margin="0,24,0,0"
                       FontSize="28"
                       FontWeight="Bold"
                       Text="{Binding PageTitle}" />
            <TextBlock Margin="0,12,0,0"
                       MaxWidth="470"
                       HorizontalAlignment="Left"
                       FontSize="15"
                       Foreground="{StaticResource MutedBrush}"
                       Text="{Binding PageDescription}"
                       TextWrapping="Wrap" />
            <Border Margin="0,24,0,0"
                    Padding="15"
                    Background="#F6F8FB"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
              <TextBlock Foreground="{StaticResource MutedBrush}"
                         Text="{Binding WelcomeNote}"
                         TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Grid>

        <Grid Visibility="{Binding IsOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock FontSize="27"
                       FontWeight="Bold"
                       Text="Options d'installation" />
            <TextBlock Margin="0,8,0,26"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Choisissez l'emplacement et les raccourcis à créer." />
            <TextBlock Margin="0,0,0,7"
                       FontWeight="SemiBold"
                       Text="Dossier d'installation" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Padding="12,10"
                       Background="#FAFBFD"
                       BorderBrush="{StaticResource BorderBrush}"
                       BorderThickness="1"
                       Text="{Binding InstallationPath, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="2"
                      Command="{Binding BrowseCommand}"
                      Content="Parcourir"
                      Style="{StaticResource SecondaryButton}" />
            </Grid>
            <CheckBox Margin="0,24,0,0"
                      Content="Créer un raccourci sur le Bureau"
                      IsChecked="{Binding CreateDesktopShortcut}" />
            <CheckBox Margin="0,12,0,0"
                      IsChecked="True"
                      IsEnabled="False"
                      Content="Créer un raccourci dans le menu Démarrer" />
            <Border Margin="0,28,0,0"
                    Padding="14"
                    Background="#EAF1FD"
                    CornerRadius="9">
              <TextBlock Foreground="#28496F"
                         Text="L'installation est autonome et ne nécessite pas le runtime .NET sur le PC cible."
                         TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Grid>

        <Grid Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel VerticalAlignment="Center">
            <ProgressBar Height="10"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Progress, Mode=OneWay}" />
            <TextBlock Margin="0,24,0,0"
                       FontSize="24"
                       FontWeight="Bold"
                       Text="{Binding PageTitle}" />
            <TextBlock Margin="0,9,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,20,0,0"
                       FontSize="13"
                       Foreground="{StaticResource PrimaryBrush}"
                       Text="{Binding Progress, StringFormat={}{0:N0}%}" />
          </StackPanel>
        </Grid>

        <Grid Visibility="{Binding IsComplete, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel VerticalAlignment="Center">
            <Border Width="72"
                    Height="72"
                    HorizontalAlignment="Left"
                    Background="#E8F8F4"
                    CornerRadius="36">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="30"
                         Foreground="#16A085"
                         Text="&#xE73E;" />
            </Border>
            <TextBlock Margin="0,24,0,0"
                       FontSize="28"
                       FontWeight="Bold"
                       Text="{Binding PageTitle}" />
            <TextBlock Margin="0,10,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       Text="{Binding PageDescription}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,18,0,0"
                       Foreground="#C2414B"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Grid>

      <Border Grid.Row="1"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid Margin="42,0">
          <Button HorizontalAlignment="Left"
                  Command="{Binding CancelCommand}"
                  Content="{Binding CancelButtonText}"
                  Style="{StaticResource SecondaryButton}" />
          <StackPanel HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Orientation="Horizontal">
            <Button Margin="0,0,10,0"
                    Command="{Binding BackCommand}"
                    Content="Retour"
                    Style="{StaticResource SecondaryButton}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Command="{Binding PrimaryCommand}"
                    Content="{Binding PrimaryButtonText}"
                    IsEnabled="{Binding CanUsePrimaryButton}"
                    Style="{StaticResource PrimaryButton}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
