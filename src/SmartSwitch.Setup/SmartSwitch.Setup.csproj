<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>SmartSwitch-Setup</AssemblyName>
    <RootNamespace>SmartSwitch.Setup</RootNamespace>
    <Version>0.1.0</Version>
    <Product>SmartSwitch Setup Wizard</Product>
    <Description>Assistant d'installation de SmartSwitch Migration Tool.</Description>
    <NoWarn>$(NoWarn);CA1822;CA1001</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(PayloadPath)' != '' and Exists('$(PayloadPath)')">
    <EmbeddedResource Include="$(PayloadPath)"
                      LogicalName="SmartSwitch.Setup.Payload.zip" />
  </ItemGroup>
</Project>
